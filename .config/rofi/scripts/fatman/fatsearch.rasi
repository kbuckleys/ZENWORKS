/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@theme "ZENON"

window {
    width: 80%;
}

/* spacing is per-box, so zeroing it to close the message/binds seam would also
 * tighten the two gaps below; those are handed back as margins. */
mainbox {
    children: [ message, textbox-binds, inputbar, listview ];
    spacing: 0;
}

/* recursivebrowser owns the message textbox ("Current directory: ..."), so the
 * bind hints live in a second textbox — filled by fatman.lua via -theme-str —
 * painted as the same block: message drops its divider, textbox-binds carries it. */
* {
    message-background: rgb(40, 47, 54, 0.4);
}

message {
    border: 0px 0px 0px 0px;
}

textbox-binds {
    background-color: @message-background;
    border-color: @selected-normal-background;
    border: 0px 0px 1px 0px;
    padding: 0px 30px 5px 30px;
    margin: 0px 0px 4.5px 0px;
    horizontal-align: 0.5;
    markup: true;
    expand: false;
}

inputbar {
    children: [textbox-prompt-colon, entry];
    border: 0px 0px 1px 0px;
    margin: 0px 0px -2px 0px;
}
textbox-prompt-colon {
    color: #fab387;
    str: "";
}
entry {
    font: "JetBrainsMono Nerd Font Propo SemiBold 13";
    color: #fab387;
}

textbox, textbox-binds {
    text-color: #6a707f;
    font: "JetBrainsMono Nerd Font Propo Bold 12";
}

listview {
    columns: 1;
    lines: 12;
    margin: 4.5px 0px 0px 0px;
}

element-text {
    font: "JetBrainsMono Nerd Font Propo SemiBold 13";
    highlight: bold #fab387;
}
