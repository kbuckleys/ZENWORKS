# ZENWORKS' own build of the AUR's otf-new-york (fixed 2026-10-13; the
# installer builds it with makepkg). Nothing of Apple's is in this repo: the
# fonts come from Apple's own download, as the AUR package fetches them.
# Apple re-issued NY.dmg
# (Last-Modified 2025-07-10), so the AUR checksum no longer matches; the new
# image nests its payload one level deeper (NYFonts.pkg/Payload, gzip of the
# cpio), and it carries the variable NewYork.ttf / NewYorkItalic.ttf — the
# plain "New York" family — beside the optical-size .otf files.

pkgname=otf-new-york
pkgver=1
pkgrel=9
_source_name="NY-Font-$pkgver-$pkgrel.dmg"
pkgdesc='Apple-designed serif typeface based on essential aspects of historical type styles. Sourced directly from Apple.'
arch=('any')
url='https://developer.apple.com/fonts/'
license=('custom')
makedepends=('p7zip')
source=("$_source_name::https://devimages-cdn.apple.com/design/resources/download/NY.dmg")
sha512sums=('160c6ea960af7afb8c92e8ced279494f111482c024d0579127d4285728be788b49bffc908bdf562ee2004ab5110094d8d06bf1925b3af3d2023bead148404843')

prepare() {
  7z x -y "$_source_name"
  7z x -y 'NYFonts/NY Fonts.pkg'
  7z x -y 'NYFonts.pkg/Payload'
  7z x -y 'Payload~'
}

package() {
  cd 'Library/Fonts/'
  install -d "${pkgdir}"/usr/share/fonts/apple
  install -m644 *.otf *.ttf "${pkgdir}"/usr/share/fonts/apple/
}
