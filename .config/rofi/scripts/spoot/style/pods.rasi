window {
    width: 1000px;
}

mainbox {
    children: [ textbox ];
}

textbox {
    text-color: #b6e0a4;
    font: "JetBrainsMono Nerd Font Propo Medium 13";
    padding: 15px 20px 30px 30px;
}
