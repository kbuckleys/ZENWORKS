[Desktop Entry]
Type=Application
Name=Minerva
GenericName=Reader
Comment=Read PDFs, EPUBs and comics, with bookmarks and highlights, in Zenworks
Icon=accessories-ebook-reader
Categories=Office;Viewer;Literature;
Keywords=pdf;epub;ebook;book;reader;document;read;comic;cbz;cbr;
Exec=/usr/share/zenworks/quickshell/minerva/bin/minerva %F
Terminal=false
StartupNotify=false
MimeType=application/pdf;application/epub+zip;application/x-pdf;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-cbz;application/x-cbr;
