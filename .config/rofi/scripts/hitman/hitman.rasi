/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@theme "ZENON"

configuration {
    kb-remove-to-sol: "BackSpace";
    kb-remove-char-back: "";
}

window {
    location: south;
    anchor: south;
    width: 1000px;
}

mainbox {
    children: [ inputbar, listview, message ];
}

inputbar {
    children: [textbox-prompt-colon, entry];
    padding: 4px 8px;
    spacing: 4px;
}

textbox {
    text-color: #9bbfbf;
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font Bold 12";
}
textbox-prompt-colon {
    str: "";
    color: #e78284;
}
entry {
    text-color: #eebebe;
}

listview {
    fixed-columns: false;
    fixed-height: false;
    scrollbar: false;
    columns: 2;
    lines: 12;
}

element {
    padding: 2px 8px 2px 8px;
}
element-text {
    highlight: bold #eebebe;
}
element-text selected {
    background-color: transparent;
    text-color: #e78284;
}

message {
    background-color: #20242a;
    padding: 4px;
}
