#!/bin/sh
# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/
#
# picasso-view [picture|folder…]   open pictures in picasso's viewer, from a
#                                   terminal, a keybind, or picasso-view.desktop
#                                   (which is how terminus and artemis get here).
#
# One picture opens its folder, at that picture; a folder opens as its
# gallery; several pictures are a gallery of just those; none is the gallery
# of ~/Pictures (wherever XDG has put it). Paths are made
# absolute HERE, because the shell answering the ipc call has no idea which
# directory this was run from — and sent in ONE call, newline-separated, so
# a selection arrives as a selection rather than as a window per file.

# With nothing named — the launcher's entry, or a bare keybind — the viewer
# opens on XDG's pictures folder, which the shell knows and this does not.
[ $# -eq 0 ] && exec qs ipc call Picasso view "" >/dev/null
paths=""
for f in "$@"; do
  p=$(realpath -m -- "$f")
  paths="${paths:+$paths
}$p"
done
exec qs ipc call Picasso view "$paths" >/dev/null
