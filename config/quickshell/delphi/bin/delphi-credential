#!/usr/bin/env python3
# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/
#
# A git credential helper for the tokens delphi keeps in its own file when
# there is no keyring (delphi/core/tokenstore.py). git asks `get` with the host
# on stdin; a host with a token there is answered, any other is left to the
# next helper. `store` and `erase` are delphi's to do, not git's: ignored.
import json
import os
import sys

if len(sys.argv) < 2 or sys.argv[1] != "get":
    sys.exit(0)
want = dict(l.split("=", 1) for l in sys.stdin.read().splitlines() if "=" in l)
if want.get("protocol") != "https" or not want.get("host"):
    sys.exit(0)
path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                    "delphi", "tokens.json")
try:
    e = json.load(open(path)).get(want["host"])
except (OSError, ValueError, AttributeError):
    sys.exit(0)
if isinstance(e, dict) and e.get("password"):
    print(f"username={e.get('username', '')}")
    print(f"password={e['password']}")
