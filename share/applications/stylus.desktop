[Desktop Entry]
Type=Application
Name=Stylus
GenericName=Disk Image Writer
Comment=Write an ISO or a disk image to a USB drive or SD card, in ZENWORKS
Icon=drive-removable-media
Categories=System;Utility;
Keywords=iso;usb;image;flash;burn;write;sd;card;bootable;etcher;rufus;dd;
Exec=/usr/share/zenworks/quickshell/stylus/bin/stylus %f
Terminal=false
StartupNotify=false
MimeType=application/x-iso9660-image;application/x-cd-image;application/x-raw-disk-image;application/x-raw-disk-image-xz-compressed;
