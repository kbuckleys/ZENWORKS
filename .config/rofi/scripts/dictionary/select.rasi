/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@theme "ZENON"

configuration {
    kb-remove-to-sol: "BackSpace";
    kb-remove-char-back: "";
}

window {
    width: 500px;
}

mainbox {
    children: [ message, inputbar, listview ];
}

inputbar {
    enabled: false;
}

listview {
    padding: 4px 0px 4px 0px;
}

element-text {
    font: "JetBrainsMono Nerd Font Propo SemiBold 13";
    horizontal-align: 0.5;
    highlight: bold #9bbfbf;
    text-color: #dfdfdd;
}

message {
    margin: 0px 0px -6px 0px;
}
textbox {
    text-color: #9bbfbf;
    font: "JetBrainsMono Nerd Font Propo SemiBold 14";
}
