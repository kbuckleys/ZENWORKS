#!/usr/bin/env bash
# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/
#
# ZENWORKS uninstaller. Run it from a clone of this repo as your normal user,
# from a TTY rather than the desktop it removes:  ./uninstall [-n]
#
#   -n                 say what would happen, change nothing (fine to run
#                      from the desktop)
#   --purge-settings   also remove the shell's settings and state (oracle.json,
#                      the stickies, every window's remembered layout).
#                      Without it they stay, for a reinstall to pick up.
#
# NOTHING YOU MADE IS REMOVED. Your notes, captures and screenshots, snippets,
# fonts you added, screen time and the git tokens stay where they are. The
# config files that are yours (config/quickshell/scripts/userfiles.txt:
# default apps, monitors, input, shortcuts, saved themes) and anything else
# that is not part of ZENWORKS are moved to ~/ZENWORKS-kept-<time>/, and
# your settings are written to ~/zenworks-settings-<date>.json, which
# Oracle's Import (About) reads after a reinstall.
#
#   1. the shell's settings exported, your files moved aside
#   2. the configs and dotfiles install laid down removed, and the ones it
#      moved aside (<name>.bak-<time>) put back
#   3. what the shell wrote elsewhere: app entries, file associations, the
#      GTK, Qt and font settings it carried the theme into, caches
#   4. what install changed system-wide put back (pacman.conf, login shell)
#      when install noted it (~/.local/state/zenworks); the extras the shell
#      can set up (NetworkManager, Bluetooth, monitor brightness) are listed,
#      never undone: turning the network off from here would strand you
#   5. the packages ZENWORKS added offered for removal, none picked: you
#      choose, and pacman refuses anything something else still needs

set -euo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE="$STATE_HOME/zenworks"
STAMP="$(date +%Y%m%d-%H%M%S)"
ME="${USER:-$(id -un)}"
KEPT="$HOME/ZENWORKS-kept-$STAMP"

CONFIGS=(
  fastfetch hypr kitty quickshell xdg-desktop-portal xdg-desktop-portal-termfilechooser
)
DOTFILES=(.zshrc .p10k.zsh)
QS="$CONFIG/quickshell"
# quickshell keeps a shell's state, data and cache under by-shell/<md5 of its
# shell.qml path>: this config's, and no other config's or test copy's
SHELL_ID="$(printf '%s' "$QS/shell.qml" | md5sum | cut -d' ' -f1)"
# a config reached through a link (stow) may be known by its real path
if [[ ! -d "$STATE_HOME/quickshell/by-shell/$SHELL_ID" && -e "$QS/shell.qml" ]]; then
  real_id="$(printf '%s' "$(readlink -f -- "$QS/shell.qml")" | md5sum | cut -d' ' -f1)"
  [[ -d "$STATE_HOME/quickshell/by-shell/$real_id" ]] && SHELL_ID="$real_id"
fi

dry=""
purge=""
for a in "$@"; do
  case "$a" in
    -n) dry=1 ;;
    --purge-settings) purge=1 ;;
    -h|--help) sed -n '7,34p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'unknown argument: %s (try -h)\n' "$a" >&2; exit 2 ;;
  esac
done

# ── output ──────────────────────────────────────────────────────────────────
CYAN=$'\e[1;38;2;155;191;191m'   # zenon cyan, #9bbfbf
DIM=$'\e[38;2;80;96;96m'
RED=$'\e[1;31m'
RESET=$'\e[0m'

say()  { printf '%s::%s %s\n' "$CYAN" "$RESET" "$*"; }
note() { printf '%s   %s%s\n' "$DIM" "$*" "$RESET"; }
item() { printf '   %s\n' "$*"; }
die()  { printf '%s:: %s%s\n' "$RED" "$*" "$RESET" >&2; exit 1; }
short() { local p="$1"; printf '%s' "${p/#$HOME/\~}"; }

banner() {
  printf '\n%s' "$CYAN"
  cat <<'EOF'
   ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
   ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
   └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
EOF
  printf '%s   uninstall%s\n\n' "$DIM" "$RESET"
}

# install.txt's value for $1 ("" when install left no notes)
noted() { [[ -f "$STATE/install.txt" ]] && sed -n "s/^$1=//p" "$STATE/install.txt" | head -n1 || true; }

# ── checks ──────────────────────────────────────────────────────────────────
preflight() {
  [[ $EUID -ne 0 ]] || die "run this as your normal user, not root; it asks for sudo itself"
  [[ -f /etc/arch-release ]] || die "this uninstaller is for Arch Linux"
  command -v python3 >/dev/null || die "python3 is needed"
  [[ -f "$REPO/config/quickshell/scripts/userfiles.txt" ]] \
    || die "missing config/quickshell/scripts/userfiles.txt; run this from the ZENWORKS repo"
  # an earlier run stopped partway leaves install's notes (they go last):
  # that is still something to finish
  [[ -f "$QS/shell.qml" || -f "$STATE/install.txt" ]] \
    || die "ZENWORKS is not installed here ($(short "$QS") has no shell.qml)"
  if [[ -z "$dry" && -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    die "this removes the desktop it is running in: log out, switch to a TTY, and run it there (-n is fine from here)"
  fi
}

# userfiles.txt's paths of the kinds named ($1, a regex), as they are on disk
userfiles() {
  local p
  while read -r p; do
    compgen -G "$CONFIG/$p" || true
  done < <(sed 's/#.*//' "$REPO/config/quickshell/scripts/userfiles.txt" \
             | awk -v k="$1" 'NF == 2 && $1 ~ "^(" k ")$" { print $2 }')
}

# ═════════════════════════════════════════════════════════════════════════════
# THE PLAN — every path is collected first and shown, and nothing changes
# before the one confirmation
# ═════════════════════════════════════════════════════════════════════════════
KEEP=()       # moved under $KEPT, by their path under $HOME
REMOVE=()     # deleted
RESTORE=()    # <name>.bak-<time> → <name>
LEFT=()       # said, never touched
APPS=()       # the .desktop ids the shell wrote
FOLIO=()      # Folio's thumbnails and ledger, beside cliphist's own db

collect_files() {
  local d f rel ours gen saved bak stamp
  stamp="$(noted stamp)"

  # your config files, and whatever is in the suite's directories that
  # ZENWORKS does not ship (Python's caches and generated files excepted)
  mapfile -t ours < <(userfiles 'generic|saved|seed')
  mapfile -t gen < <(userfiles generated)
  mapfile -t saved < <(userfiles saved)
  # a generic or seed file still the package's own copy was never your
  # choice; a saved one always is
  for f in "${ours[@]}"; do
    if ! in_list "$f" "${saved[@]}" && [[ -f "$REPO/config/${f#"$CONFIG/"}" ]] \
       && sed "s|@CONFIG@|$CONFIG|g" "$REPO/config/${f#"$CONFIG/"}" | cmp -s - "$f"; then
      continue
    fi
    KEEP+=("$f")
  done
  for d in "${CONFIGS[@]}"; do
    [[ -e "$CONFIG/$d" ]] || continue
    # a link (stow, a dotfiles repo) is yours to undo: removing what it
    # points into would reach into that repo
    if [[ -L "$CONFIG/$d" ]]; then
      LEFT+=("$(short "$CONFIG/$d")  a link to $(short "$(readlink -f -- "$CONFIG/$d")"); remove it where you made it (stow -D)")
      continue
    fi
    # only a directory holding some file ZENWORKS ships is ZENWORKS's: the
    # one put back by an earlier run is not
    if ! ships "$d"; then LEFT+=("$(short "$CONFIG/$d")  not ZENWORKS's"); continue; fi
    while IFS= read -r -d '' f; do
      rel="${f#"$CONFIG/"}"
      [[ -e "$REPO/config/$rel" ]] && continue
      case "$rel" in */__pycache__/*|*.pyc) continue ;; esac
      in_list "$f" "${ours[@]}" && continue
      in_list "$f" "${gen[@]}" && continue
      KEEP+=("$f")
    done < <(find "$CONFIG/$d" -type f -print0)
    REMOVE+=("$CONFIG/$d")
    bak="$(original_backup "$CONFIG/$d" "$stamp")"
    [[ -n "$bak" ]] && RESTORE+=("$bak")
    later_backups "$CONFIG/$d" "$bak"
  done

  # the dotfiles: kept when you have changed them since
  for f in "${DOTFILES[@]}"; do
    [[ -e "$HOME/$f" ]] || continue
    if [[ -L "$HOME/$f" ]]; then
      LEFT+=("$(short "$HOME/$f")  a link to $(short "$(readlink -f -- "$HOME/$f")"); remove it where you made it (stow -D)")
      continue
    fi
    if cmp -s "$HOME/$f" "$REPO/home/$f"; then REMOVE+=("$HOME/$f")
    else KEEP+=("$HOME/$f"); REMOVE+=("$HOME/$f"); fi
    bak="$(original_backup "$HOME/$f" "$stamp")"
    [[ -n "$bak" ]] && RESTORE+=("$bak")
    later_backups "$HOME/$f" "$bak"
  done

  # the shipped .zshrc fetches zinit and its plugins, and p10k keeps caches:
  # theirs to go unless the .zshrc left behind (one put back) uses them
  if in_list "$HOME/.zshrc" "${REMOVE[@]}"; then
    bak="$(original_backup "$HOME/.zshrc" "$stamp")"
    if [[ -z "$bak" ]] || ! grep -q 'zinit' "$bak"; then
      for f in "$DATA/zinit" "$CACHE/zinit" "$CACHE"/p10k-*; do
        [[ -e "$f" ]] && REMOVE+=("$f")
      done
    fi
  fi
  return 0
}

ships() {
  local f
  while IFS= read -r -d '' f; do
    [[ -f "$REPO/config/${f#"$CONFIG/"}" ]] && return 0
  done < <(find "$CONFIG/$1" -type f -print0)
  return 1
}

in_list() { local x="$1" y; shift; for y in "$@"; do [[ "$x" == "$y" ]] && return 0; done; return 1; }

# The copy install made of what was there before ZENWORKS: the one from the
# first install's time when install noted it, else the oldest. Later ones are
# earlier ZENWORKS copies, from installing over it again, and are left.
original_backup() {
  local base="$1" stamp="$2" b
  if [[ -n "$stamp" ]]; then
    [[ -e "$base.bak-$stamp" ]] && printf '%s' "$base.bak-$stamp"
    return 0
  fi
  b="$(compgen -G "$base.bak-*" | sort | head -n1 || true)"
  printf '%s' "$b"
}

# The other <name>.bak-<time> copies: made by installing over ZENWORKS
# again, so they hold an earlier ZENWORKS and whatever of yours was in it.
# Said, never touched.
later_backups() {
  local b
  while IFS= read -r b; do
    [[ -n "$b" && "$b" != "$2" ]] && LEFT+=("$(short "$b")  an earlier ZENWORKS copy, from installing again")
  done < <(compgen -G "$1.bak-*" | sort)
  return 0
}

# an XDG user directory; xdg-user-dir answers $HOME for one never set
user_dir() {
  local d
  d="$(xdg-user-dir "$1" 2>/dev/null || true)"
  [[ -n "$d" && "$d" != "$HOME" ]] && printf '%s' "$d" || printf '%s' "$HOME/$2"
}

collect_shell_writes() {
  local id f
  # the shell writes its app entries itself (Desktop.installCommand); the ids
  # are read from it, so a new app is never missed here
  # and every entry still running from this config, and the ids an earlier,
  # stopped run had found (kept in install's notes until the end)
  mapfile -t APPS < <(
    # (each may find nothing, which set -e and pipefail would stop on)
    { [[ -d "$QS" ]] && grep -rhoE 'installCommand\("[a-z-]+"' --include='*.qml' "$QS" | sed 's/.*("//; s/"$//'; } || true
    { grep -lr --include='*.desktop' "^Exec=.*$QS/" "$DATA/applications" 2>/dev/null | sed 's|.*/||; s|\.desktop$||'; } || true
    { [[ -f "$STATE/apps.txt" ]] && cat "$STATE/apps.txt"; } || true)
  mapfile -t APPS < <(printf '%s\n' "${APPS[@]}" | grep . | sort -u)
  for id in "${APPS[@]}"; do
    f="$DATA/applications/$id.desktop"
    # only an entry still running from this config: one you rewrote is yours
    [[ -f "$f" ]] && grep -q "^Exec=.*$QS/" "$f" && REMOVE+=("$f")
  done

  # the theme and fonts carried to GTK, Qt and fontconfig (ThemeSync,
  # fontsync.sh); gtk.css only loses its @import line, below
  for f in "$CONFIG/gtk-3.0/colors.css" "$CONFIG/gtk-4.0/colors.css" \
           "$CONFIG/qt6ct/colors/zenworks.conf" \
           "$CONFIG/fontconfig/conf.d/50-oracle-fonts.conf" \
           "$CONFIG/fontconfig/conf.d/60-quickshell-glyphs.conf"; do
    [[ -e "$f" ]] && REMOVE+=("$f")
  done
  f="$CONFIG/qt6ct/qt6ct.conf"
  [[ -f "$f" ]] && grep -q 'Written by the shell (morpheus/ThemeSync.qml)' "$f" && REMOVE+=("$f")

  # caches: the shell's own, and the ones its layers keep beside it
  for f in "$CACHE"/quickshell/*; do
    [[ -e "$f" ]] || continue
    [[ "$(basename -- "$f")" == by-shell ]] && continue
    REMOVE+=("$f")
  done
  for f in "$CACHE/quickshell/by-shell/$SHELL_ID" \
           "$CACHE"/{picasso,ceres,terminus,alexandria} \
           "$CACHE"/{metis-history,metis-names,metis-places.tsv,metis-rates} \
           "$CACHE"/{dict-cache,dict-history,translate-cache,translate-history,translate-usage} \
           "$CACHE"/{cynosure-freq,cynosure-history,cerberus.log} \
           "$DATA/quickshell/plato" "$DATA/quickshell/by-shell/$SHELL_ID" \
           "$STATE_HOME/quickshell/plato"; do
    [[ -e "$f" ]] && REMOVE+=("$f")
  done
  # Folio keeps its thumbnails (<id>.png) and folio-ledger.json in
  # cliphist's directory; cliphist's db there is the clipboard history
  for f in "$CACHE/cliphist/folio-ledger.json" "$CACHE"/cliphist/[0-9]*.png; do
    [[ -f "$f" ]] && FOLIO+=("$f")
  done

  # Picasso's cut-out model (cutout.py --fetch): this one file, as rembg may
  # keep its own beside it
  f="${U2NET_HOME:-${XDG_DATA_HOME:-$HOME}/.u2net}/isnet-general-use.onnx"
  [[ -f "$f" ]] && REMOVE+=("$f")

  # the shell's settings and state
  f="$STATE_HOME/quickshell/by-shell/$SHELL_ID"
  if [[ -e "$f" ]]; then
    if [[ -n "$purge" ]]; then REMOVE+=("$f")
    else LEFT+=("$(short "$f")  your settings, for a reinstall (--purge-settings removes them)"); fi
  fi

  # yours, untouched
  local docs pics vids
  docs="$(user_dir DOCUMENTS Documents)"; pics="$(user_dir PICTURES Pictures)"; vids="$(user_dir VIDEOS Videos)"
  for f in "$docs/Clio:notes" "$docs/Snippets:snippets" "$pics/Screenshots:screenshots" \
           "$pics/Scans:scans" \
           "$vids/Captures:recordings" "$DATA/kairos:screen time" \
           "$DATA/folio:older snippets" "$CONFIG/delphi:git sign-ins" \
           "$CONFIG/khal:Chronos' calendar settings" "$DATA/khal:your calendars" \
           "$CONFIG/Bitwarden CLI:Calypso's Bitwarden sign-ins" \
           "$DATA/fonts:fonts you added" \
           "$CACHE/cliphist/db:clipboard history (cliphist's own)" \
           "$CONFIG/xdg-terminals.list:the terminal choice Oracle wrote"; do
    [[ -e "${f%%:*}" ]] && LEFT+=("$(short "${f%%:*}")  ${f#*:}")
  done
  for f in "$CONFIG/gtk-3.0/settings.ini" "$CONFIG/gtk-4.0/settings.ini"; do
    [[ -f "$f" ]] && grep -q '^gtk-font-name=\|^gtk-application-prefer-dark-theme=' "$f" \
      && LEFT+=("$(short "$f")  the font and dark-mode lines the shell set (GTK's own file)")
  done
  return 0
}

# ── system-wide ─────────────────────────────────────────────────────────────
PACMAN_RESTORE=""
SHELL_BACK=""
BANDWHICH=()

collect_system() {
  local f old cur
  f="$(noted pacman_conf)"
  if [[ -n "$f" && -f "$f" ]]; then
    # only while pacman.conf is still the one install laid: one changed since
    # (Ceres' Repositories) is your choice now
    if cmp -s /etc/pacman.conf "$REPO/etc/pacman.conf"; then PACMAN_RESTORE="$f"
    else LEFT+=("/etc/pacman.conf  changed since install; $f is the one from before"); fi
  fi

  old="$(noted shell)"
  cur="$(getent passwd "$ME" | cut -d: -f7)"
  if [[ -n "$old" && "$old" != "$cur" ]] && grep -qxF "$old" /etc/shells; then SHELL_BACK="$old"; fi

  # scripts/bandwhich-grant.sh: the capability, and what re-applies it
  for f in /etc/pacman.d/hooks/bandwhich-setcap.hook \
           /etc/systemd/system/bandwhich-setcap.path /etc/systemd/system/bandwhich-setcap.service; do
    [[ -e "$f" ]] && BANDWHICH+=("$f")
  done

  # what Hermes sets up, said and left
  if systemctl is-enabled -q NetworkManager.service 2>/dev/null; then
    LEFT+=("NetworkManager  on (Hermes may have swapped it in for systemd-networkd; left, to keep you online)")
  fi
  systemctl is-enabled -q bluetooth.service 2>/dev/null && LEFT+=("bluetooth.service  enabled")
  systemctl is-enabled -q cups.socket 2>/dev/null && LEFT+=("cups.socket  enabled (Hermes' printing), and your printers")
  systemctl is-enabled -q avahi-daemon.service 2>/dev/null && LEFT+=("avahi-daemon.service  enabled (finding printers on the network)")
  systemctl is-enabled -q fwupd-refresh.timer 2>/dev/null && LEFT+=("fwupd-refresh.timer  enabled (Hestia's firmware updates)")
  [[ -e /etc/modules-load.d/i2c-dev.conf ]] && LEFT+=("/etc/modules-load.d/i2c-dev.conf  monitor brightness (ddcutil)")
  flatpak remotes --system 2>/dev/null | grep -q '^flathub' && LEFT+=("flathub  Flatpak's system remote")
  return 0
}

# ── packages ────────────────────────────────────────────────────────────────
PKGS=()
PKG_NOTE=""

# Everything ZENWORKS can put on a machine: the installer's list, what the
# shell installed for itself through Ceres (noted in added.txt since
# 2026-10-22), the package names its code asks for (for installs from before
# that), and paru when install built it. Offered only when it was not there
# before install ran.
collect_packages() {
  local wanted p
  wanted="$(sed -n '/^PACKAGES=(/,/^)/p' "$REPO/install" | sed 's/#.*//' | tr -s ' \t' '\n' \
            | grep -v -e '^PACKAGES=($' -e '^)$' -e '^$' || true)"
  [[ -f "$STATE/added.txt" ]] && wanted+=$'\n'"$(cat "$STATE/added.txt")"
  if [[ -d "$QS" ]]; then
    # pkgs: ["a", "b"], pkg: "a", Ceres.install(["a"]) / ("a"), fwStep(…, ["a"]
    wanted+=$'\n'"$(grep -rhoE --include='*.qml' --include='*.js' --exclude-dir=tests \
        -e 'pkgs?: *(\[[^]]*\]|"[^"]+")' -e 'Ceres\.install\( *(\[[^]]*\]|"[^"]+")' \
        -e 'fwStep\("[^"]*", *\[[^]]*\]' "$QS" 2>/dev/null \
      | sed 's/^fwStep("[^"]*", *//; s/^[^(["]*[(]*//' | grep -oE '"[a-z0-9][a-z0-9@._+-]*"' | tr -d '"' || true)"
    # and the Python backends' own (Calypso's PKG = "…", return "…-bin", …)
    wanted+=$'\n'"$(grep -rhoE --include='*.py' --exclude-dir=tests -e '^ *PKG = "[^"]+"' \
        -e 'return "[a-z0-9._+-]+", (True|False)' "$QS" 2>/dev/null | grep -oE '"[^"]+"' | tr -d '"' || true)"
  fi
  if [[ "$(noted paru)" == built ]]; then wanted+=$'\n'"$(pacman -Qqo "$(command -v paru)" 2>/dev/null || true)"; fi

  if [[ ! -f "$STATE/before-install.txt" ]]; then
    PKG_NOTE="install left no notes here (it began keeping them on 2026-10-22), so which packages were already yours is not known: none are offered"
    return 0
  fi
  # by the name installed: pacman answers a provided name (bitwarden-cli)
  # with the package that provides it (bitwarden-cli-bin)
  for p in $(printf '%s\n' "$wanted" | sort -u | xargs -r pacman -Qq 2>/dev/null | sort -u); do
    grep -qxF "$p" "$STATE/before-install.txt" && continue
    PKGS+=("$p")
  done
  return 0
}

# ═════════════════════════════════════════════════════════════════════════════
show_plan() {
  local f
  say "Your settings, saved first"
  item "$(short "$HOME")/zenworks-settings-$(date +%F).json  (Oracle → About → Import reads it)"
  if (( ${#KEEP[@]} )); then
    say "Moved to $(short "$KEPT")"
    for f in "${KEEP[@]}"; do item "$(short "$f")"; done
  fi
  say "Removed"
  for f in "${REMOVE[@]}"; do in_list "$f" "${KEEP[@]}" || item "$(short "$f")"; done
  (( ${#FOLIO[@]} )) && item "$(short "$CACHE/cliphist")  Folio's thumbnails and ledger, ${#FOLIO[@]} files (cliphist's db stays)"
  for f in "$CONFIG/gtk-3.0/gtk.css" "$CONFIG/gtk-4.0/gtk.css"; do
    [[ -f "$f" ]] && grep -qxF '@import url("colors.css");' "$f" && item "$(short "$f")  (its @import line)"
  done
  (( ${#APPS[@]} )) && note "file associations naming ${#APPS[@]} suite apps are dropped from mimeapps.list"
  note "the GNOME interface keys the shell set (color scheme, GTK theme, fonts) go back to their defaults"
  if (( ${#RESTORE[@]} )); then
    say "Put back, as they were before ZENWORKS"
    for f in "${RESTORE[@]}"; do item "$(short "${f%.bak-*}")  ← $(basename -- "$f")"; done
  fi
  if [[ -n "$PACMAN_RESTORE" || -n "$SHELL_BACK" || ${#BANDWHICH[@]} -gt 0 ]]; then
    say "System-wide (asks for sudo)"
    [[ -n "$PACMAN_RESTORE" ]] && item "/etc/pacman.conf  ← $PACMAN_RESTORE"
    [[ -n "$SHELL_BACK" ]] && item "login shell  → $SHELL_BACK"
    for f in "${BANDWHICH[@]}"; do item "$f  (bandwhich's capability, removed with it)"; done
  fi
  if (( ${#LEFT[@]} )); then
    say "Left as they are"
    for f in "${LEFT[@]}"; do item "$f"; done
  fi
  say "Packages"
  if [[ -n "$PKG_NOTE" ]]; then note "$PKG_NOTE"
  elif (( ${#PKGS[@]} )); then note "${#PKGS[@]} added by ZENWORKS; you pick which go, after the files: ${PKGS[*]}"
  else note "none added by ZENWORKS are installed"; fi
  return 0
}

# ═════════════════════════════════════════════════════════════════════════════
# DOING IT
# ═════════════════════════════════════════════════════════════════════════════

# Oracle's Export, made here: the same bundle (oracle.js makeBundle), so a
# reinstall's Import brings it all back
export_settings() {
  local out n=2
  out="$HOME/zenworks-settings-$(date +%F).json"
  while [[ -e "$out" ]]; do out="$HOME/zenworks-settings-$(date +%F)-$n.json"; n=$((n + 1)); done
  python3 -I - "$out" "$STATE_HOME/quickshell/by-shell/$SHELL_ID/oracle.json" "$CONFIG/hypr/lua" "$QS/themes" <<'PY'
import datetime, glob, json, os, re, sys
out, oracle, lua, themes = sys.argv[1:]
files = {}
def take(rel, path):
    try:
        with open(path, encoding="utf-8") as f:
            t = f.read()
    except OSError:
        return
    if t:
        files[rel] = t
take("oracle.json", oracle)
for n in ("keys", "wake", "defaults", "input", "monitors"):
    take("hypr/%s.lua" % n, os.path.join(lua, n + ".lua"))
for p in glob.glob(os.path.join(themes, "*.json")):
    b = os.path.basename(p)
    if re.match(r"^(custom|wallpaper)-[A-Za-z0-9_-]*\.json$", b):
        take("themes/" + b, p)
made = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
bundle = {"zenworks": "settings", "v": 1, "made": made, "files": dict(sorted(files.items()))}
with open(out, "w", encoding="utf-8") as f:
    f.write(json.dumps(bundle, indent=1, ensure_ascii=False) + "\n")
PY
  note "settings saved to $(short "$out")"
}

keep_files() {
  local f rel
  (( ${#KEEP[@]} )) || return 0
  for f in "${KEEP[@]}"; do
    [[ -e "$f" ]] || continue
    rel="${f#"$HOME/"}"
    mkdir -p -- "$KEPT/$(dirname -- "$rel")"
    mv -- "$f" "$KEPT/$rel"
  done
  note "your files moved to $(short "$KEPT")"
}

remove_files() {
  local f
  for f in "${REMOVE[@]}"; do
    [[ -e "$f" || -L "$f" ]] && rm -rf -- "$f"
  done
  (( ${#FOLIO[@]} )) && rm -f -- "${FOLIO[@]}"
  for f in "${RESTORE[@]}"; do
    [[ -e "${f%.bak-*}" ]] || mv -- "$f" "${f%.bak-*}"
  done
  # directories left empty behind the files
  for f in "$CONFIG/qt6ct/colors" "$CONFIG/qt6ct" "$CONFIG/fontconfig/conf.d" "$CONFIG/fontconfig" \
           "$CACHE/quickshell/by-shell" "$CACHE/quickshell" "$DATA/quickshell/by-shell" "$DATA/quickshell" \
           "$STATE_HOME/quickshell/by-shell" "$STATE_HOME/quickshell" \
           "${U2NET_HOME:-${XDG_DATA_HOME:-$HOME}/.u2net}"; do
    [[ -d "$f" ]] && rmdir --ignore-fail-on-non-empty -- "$f"
  done
  return 0
}

undo_shell_writes() {
  local f
  # gtk.css: our line only; a file with nothing else left goes
  for f in "$CONFIG/gtk-3.0/gtk.css" "$CONFIG/gtk-4.0/gtk.css"; do
    [[ -f "$f" ]] || continue
    grep -qxF '@import url("colors.css");' "$f" || continue
    grep -vxF -e '@import url("colors.css");' \
      -e '/* The shell'"'"'s theme: colors.css is written by quickshell (morpheus/ThemeSync.qml). */' \
      "$f" > "$f.zw" || true
    if grep -q '[^[:space:]]' "$f.zw"; then mv -f -- "$f.zw" "$f"; else rm -f -- "$f.zw" "$f"; fi
  done

  # mimeapps.list: the suite's apps out of every association they are in
  (( ${#APPS[@]} )) && for f in "$CONFIG/mimeapps.list" "$DATA/applications/mimeapps.list"; do
    [[ -f "$f" ]] || continue
    python3 -I - "$f" "${APPS[@]}" <<'PY'
import os, sys
path, ids = sys.argv[1], {i + ".desktop" for i in sys.argv[2:]}
out, section = [], ""
with open(path, encoding="utf-8") as f:
    lines = f.read().splitlines()
for l in lines:
    s = l.strip()
    if s.startswith("["):
        section = s
    elif "=" in l and section in ("[Default Applications]", "[Added Associations]"):
        k, v = l.split("=", 1)
        keep = [x for x in v.split(";") if x and x not in ids]
        if not keep:
            continue
        l = k + "=" + ";".join(keep) + ";"
    out.append(l)
with open(path + ".zw", "w", encoding="utf-8") as f:
    f.write("\n".join(out) + "\n")
os.replace(path + ".zw", path)
PY
  done
  command -v update-desktop-database >/dev/null && update-desktop-database -q "$DATA/applications" 2>/dev/null || true
  command -v fc-cache >/dev/null && fc-cache -f >/dev/null 2>&1 || true

  if command -v gsettings >/dev/null; then
    for f in color-scheme gtk-theme font-name document-font-name monospace-font-name; do
      gsettings reset org.gnome.desktop.interface "$f" 2>/dev/null || true
    done
  fi
  return 0
}

undo_system() {
  local f bin
  [[ -n "$PACMAN_RESTORE$SHELL_BACK" || ${#BANDWHICH[@]} -gt 0 ]] || return 0
  sudo -v
  if [[ -n "$PACMAN_RESTORE" ]]; then
    sudo install -m 644 -- "$PACMAN_RESTORE" /etc/pacman.conf && note "pacman.conf put back"
  fi
  if (( ${#BANDWHICH[@]} )); then
    sudo systemctl disable --now bandwhich-setcap.path 2>/dev/null || true
    sudo rm -f -- "${BANDWHICH[@]}"
    sudo systemctl daemon-reload 2>/dev/null || true
    bin="$(command -v bandwhich || true)"
    [[ -n "$bin" ]] && sudo setcap -r "$bin" 2>/dev/null || true
    note "bandwhich's capability removed"
  fi
  if [[ -n "$SHELL_BACK" ]]; then
    chsh -s "$SHELL_BACK" && note "login shell is $SHELL_BACK again" || note "chsh failed; run: chsh -s $SHELL_BACK"
  fi
}

# The packages, picked by number. Ones another installed package still needs
# are not offered: pacman would refuse the whole removal over one of them.
remove_packages() {
  local p need free=() picked=() n choice login
  (( ${#PKGS[@]} )) || return 0
  # never the package of the shell you log in with (zsh, if chsh back failed)
  login="$(pacman -Qqo "$(getent passwd "$ME" | cut -d: -f7)" 2>/dev/null || true)"
  for p in "${PKGS[@]}"; do
    if [[ -n "$login" && "$p" == "$login" ]]; then note "$p stays: it is your login shell"; continue; fi
    need="$(LC_ALL=C pacman -Qi "$p" | sed -n 's/^Required By *: //p' | tr -s ' ' '\n' | grep -v -e '^None$' -e '^$' || true)"
    need="$(printf '%s\n' "$need" | grep -vxF -f <(printf '%s\n' "${PKGS[@]}") || true)"
    if [[ -n "$need" ]]; then note "$p stays: $(printf '%s' "$need" | tr '\n' ' ')needs it"
    else free+=("$p"); fi
  done
  (( ${#free[@]} )) || return 0

  say "Packages ZENWORKS added (none picked)"
  n=1
  for p in "${free[@]}"; do printf '   %s%3d%s  %s\n' "$DIM" "$n" "$RESET" "$p"; n=$((n + 1)); done
  read -rp "   numbers to remove (e.g. 1 4 7), a for all, Enter for none: " choice || choice=""
  case "$choice" in
    "") note "no packages removed"; return 0 ;;
    a|A) picked=("${free[@]}") ;;
    *) for n in $choice; do
         [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#free[@]} )) && picked+=("${free[n-1]}") \
           || note "skipped $n: not on the list"
       done ;;
  esac
  (( ${#picked[@]} )) || return 0
  # pacman shows the whole removal, and asks, itself
  sudo pacman -Rns -- "${picked[@]}" || note "pacman removed nothing; the packages are as they were"

  # GTK's theme name, if it was adw-gtk3 and that is gone now
  if ! pacman -Qq adw-gtk-theme >/dev/null 2>&1; then
    for p in "$CONFIG/gtk-3.0/settings.ini" "$CONFIG/gtk-4.0/settings.ini"; do
      [[ -f "$p" ]] && sed -i '/^gtk-theme-name=adw-gtk3/d' "$p"
    done
  fi
  return 0
}

finish() {
  rm -rf -- "$STATE"
  printf '\n'
  say "ZENWORKS is uninstalled."
  note "Your settings: $(ls -t "$HOME"/zenworks-settings-*.json 2>/dev/null | head -n1 | sed "s|^$HOME|~|")"
  [[ -d "$KEPT" ]] && note "Your other files: $(short "$KEPT")"
  note "Log in again for the login shell and session to change."
  printf '\n'
}

# ═════════════════════════════════════════════════════════════════════════════
banner
preflight
collect_files
collect_shell_writes
collect_system
collect_packages
show_plan

if [[ -n "$dry" ]]; then
  printf '\n'
  note "-n: nothing was changed"
  exit 0
fi

printf '\n'
read -rp "   Uninstall ZENWORKS? [y/N] " yes || yes=""
[[ "$yes" == [yY]* ]] || { note "nothing was changed"; exit 0; }

# stopped partway (Ctrl-C, an error): running it again finishes the job
trap 'printf "\n"; exit 130' INT TERM
trap '[[ $? -eq 0 ]] || printf "%s:: stopped partway; run ./uninstall again to finish%s\n" "$RED" "$RESET" >&2' EXIT
mkdir -p -- "$STATE" && printf '%s\n' "${APPS[@]}" > "$STATE/apps.txt"

export_settings
keep_files
remove_files
undo_shell_writes
undo_system
remove_packages
finish
