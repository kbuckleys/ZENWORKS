#!/bin/sh
# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/
#
# stylus [image]   the window, from a terminal, a keybind, or stylus.desktop
#                  (terminus' "Open with"); an image is chosen in it.
# The path is made absolute here: the shell answering has no idea which
# directory this ran in.
[ $# -eq 0 ] && exec qs ipc call Stylus open "" >/dev/null
f=$1
case $f in file://*) f=$(printf '%s' "${f#file://}" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g' | xargs -0 printf '%b');; esac
exec qs ipc call Stylus write "$(realpath -m -- "$f")" >/dev/null
