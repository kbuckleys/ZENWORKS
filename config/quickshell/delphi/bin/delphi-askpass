#!/usr/bin/env python3
# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/
#
# DELPHI ASKPASS — git's and ssh's questions, answered from delphi's window.
#
# git runs GIT_ASKPASS, ssh runs SSH_ASKPASS, each with the prompt as its one
# argument, and reads the answer from stdout. This passes the prompt to the
# daemon over its socket (DELPHI_SOCK), which shows it as a card and sends
# back what the user typed. Like ceres' askpass, the answer is never in argv,
# never in the environment, never on disk: it crosses one socket, once.
#
# No answer (dismissed, timed out, no daemon) exits 1 — git and ssh read that
# as "cancelled" and fail the operation instead of retrying.

import json
import os
import socket
import sys

sock = os.environ.get("DELPHI_SOCK")
prompt = sys.argv[1] if len(sys.argv) > 1 else ""
if not sock:
    sys.exit(1)
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(300)
    s.connect(sock)
    s.sendall((json.dumps({"prompt": prompt,
                           "kind": os.environ.get("SSH_ASKPASS_PROMPT", "")})
               + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
    s.close()
    ans = json.loads(buf.decode() or "{}")
except (OSError, ValueError):
    sys.exit(1)
if ans.get("answer") is None:
    sys.exit(1)
sys.stdout.write(ans["answer"] + "\n")
