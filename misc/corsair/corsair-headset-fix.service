[Unit]
Description=Fix Corsair VOID ELITE headset audio (analog profile + gain)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
# setup.sh symlinks the script here before enabling this unit, so this path
# holds no matter where the corsair directory itself lives. Don't point it at
# the directory — that would tie the unit to one install location.
ExecStart=%h/.local/bin/corsair-headset-fix

[Install]
WantedBy=default.target
