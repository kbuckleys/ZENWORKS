/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@import "ZENON"

* {
    selected-normal-background: #fab387;
}

window {
    width: 100%;
    border-radius: 0;
    children: [ mainbox ];
}
mainbox {
    children: [ hbox ];
}
hbox {
    orientation: horizontal;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ textbox-prompt-colon, entry ];
    width: 20%;
}
textbox-prompt-colon {
    padding: 6px 0px 6px 10px;
    color: #fab387;
    str: " ";
}
entry {
    text-color: #fab387;
}

listview {
    layout: horizontal;
}

element-text {
    highlight: bold;
    text-color: #fab387;
}
element-text.selected {
    text-color: #000000;
}
