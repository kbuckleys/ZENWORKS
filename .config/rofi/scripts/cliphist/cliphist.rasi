/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@theme "ZENON"

configuration {
    kb-remove-to-sol: "BackSpace";
    kb-remove-char-back: "";
}

window {
    location: south;
    anchor: south;
    width: 80%;
}

mainbox {
    children: [message, inputbar, listview];
}

inputbar {
    enabled: false;
}

listview {
    fixed-columns: false;
    fixed-height: false;
    scrollbar: false;
    columns: 3;
    lines: 12;
}

element {
    padding: 2px 8px 2px 8px;
}
element-text {
    highlight: bold #eebebe;
}
element-text selected {
    background-color: transparent;
}

message {
    background-color: #16191d;
    padding: 5px 5px 5px 5px;
}
textbox {
    text-color: #eebebe;
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font Bold 12";
}
