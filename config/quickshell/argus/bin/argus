#!/bin/sh
# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/
#
# argus [video]   the editor, from a terminal, a keybind, or argus.desktop
#                 (terminus' "Open with"); none is the newest recording.
# The path is made absolute here: the shell answering has no idea which
# directory this ran in.
[ $# -eq 0 ] && exec qs ipc call Argus last >/dev/null
f=$1
case $f in file://*) f=$(printf '%s' "${f#file://}" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g' | xargs -0 printf '%b');; esac
exec qs ipc call Argus edit "$(realpath -m -- "$f")" >/dev/null
