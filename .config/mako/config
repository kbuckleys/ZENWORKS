# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# https://github.com/kbuckleys/

font=JetBrainsMono Nerd Font Propo SemiBold 12
background-color=#dfdfdd
text-color=#000000
border-color=#20242a
progress-color=over #20242a
border-size=1
border-radius=5
margin=2
outer-margin=0,0,20
padding=5
width=400
height=400
anchor=bottom-center
layer=overlay
default-timeout=5000
max-visible=5
icons=1
max-icon-size=96
icon-border-radius=5
icon-path=/usr/share/icons/Adwaita/16x16/status/:/usr/share/icons/Adwaita/16x16/devices/
icon-location=left
markup=1
format=<b>%s</b>\n%b
text-alignment=center
sort=-priority
history=0

[urgency=low]
background-color=#b6e0a4
text-color=#000000
border-color=#20242a
default-timeout=4000

[urgency=normal]
background-color=#dfdfdd
text-color=#000000
border-color=#20242a
default-timeout=4000

[urgency=critical]
background-color=#fab387
text-color=#000000
border-color=#20242a
default-timeout=0
